classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str time
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~Task~
        +sort_by_priority(tasks: list~Task~) list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
